# Copy this file to .env and fill in real values. .env is gitignored.
# Never commit real credentials.

# --- Postgres ---
POSTGRES_DB=commerce
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser
# 5433, not 5432 -- avoids colliding with a native/other local Postgres install
# already using the default port.
POSTGRES_PORT=5433

# Application roles created by infrastructure/postgres/init/01_roles.sh
COMMERCE_APP_PASSWORD=changeme_app
COMMERCE_READONLY_PASSWORD=changeme_readonly
# Used by the Debezium connector (ingestion/debezium/postgres-connector.json).
DEBEZIUM_PASSWORD=changeme_debezium

# --- Adminer ---
ADMINER_PORT=8081

# --- Generator: connection used by scripts/seed_database.py and generate_data.py ---
# Uses the commerce_app role, not the superuser -- the generator simulates
# the OLTP application, not a DBA.
GENERATOR_DB_HOST=localhost
GENERATOR_DB_PORT=5433
GENERATOR_DB_NAME=commerce
GENERATOR_DB_USER=commerce_app
GENERATOR_DB_PASSWORD=changeme_app

# --- Generator: volumes (bulk seed) ---
SEED_CUSTOMERS=10000
SEED_PRODUCTS=10000
SEED_ORDERS=1000000
SEED_ORDER_ITEMS_MAX_PER_ORDER=4
SEED_BATCH_SIZE=25000
SEED_RANDOM_SEED=42

# --- Generator: streaming simulation rates (events/minute) ---
SIM_NEW_CUSTOMERS_PER_MIN=5
SIM_NEW_ORDERS_PER_MIN=50
SIM_ORDER_STATUS_CHANGES_PER_MIN=40
SIM_PAYMENT_CHANGES_PER_MIN=40
SIM_INVENTORY_CHANGES_PER_MIN=20
SIM_SHIPMENT_CHANGES_PER_MIN=30
SIM_PROFILE_UPDATES_PER_MIN=5
SIM_PRICE_STOCK_CHANGES_PER_MIN=10
SIM_ORDER_ITEM_DELETIONS_PER_MIN=5

# --- Phase 2: Kafka (KRaft) ---
# External/host-facing listener, for debugging with a host-side Kafka CLI.
# kafka-connect and spark-bronze-writer talk to the kafka:9092 internal listener.
KAFKA_EXTERNAL_PORT=9094
KAFKA_CONNECT_PORT=8083

# --- Phase 2: MinIO (Iceberg object storage) ---
MINIO_ROOT_USER=commerce_minio
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LAKEHOUSE_BUCKET=lakehouse

# --- Phase 2: Nessie (Iceberg catalog) ---
NESSIE_PORT=19120
NESSIE_DEFAULT_BRANCH=main
